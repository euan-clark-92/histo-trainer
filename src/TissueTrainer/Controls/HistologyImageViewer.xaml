<UserControl
    x:Class="TissueTrainer.Controls.HistologyImageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ZoomOutButton" Content="-" Width="36" Click="ZoomOutButton_Click" />
            <Button x:Name="ZoomInButton" Content="+" Width="36" Click="ZoomInButton_Click" />
            <Button x:Name="ResetZoomButton" Content="Reset" Click="ResetZoomButton_Click" />
            <TextBlock x:Name="ZoomLevelText"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ZoomMode="Disabled"
                          PointerWheelChanged="ImageScrollViewer_PointerWheelChanged">
                <Image x:Name="SlideImage"
                       Stretch="Uniform"
                       ManipulationMode="TranslateX,TranslateY"
                       ManipulationDelta="SlideImage_ManipulationDelta" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
